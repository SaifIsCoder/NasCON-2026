# ==============================================================================
# NaSCon '26 Part I: Multi-Sport League & Club Operations Platform
# Environment Variables Configuration Template
# ==============================================================================

# Core Application Settings
PORT=8080
NODE_ENV=production

# Per-Team Cryptographic Salt (REQUIRED for Autograder & HMAC Signatures)
# DO NOT hardcode or commit the real secret salt.
# Provide via: export DAY1_SALT="<your-salt>" or DAY1_SALT=<salt> docker compose up -d --build
DAY1_SALT=

# PostgreSQL Database Configuration (PostgreSQL 16)
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_password
POSTGRES_DB=nascon_db
DATABASE_URL=postgresql://nascon:nascon_password@localhost:5432/nascon_db

# Redis Configuration (Redis 7)
REDIS_URL=redis://localhost:6379

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=nascon-receipts

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
